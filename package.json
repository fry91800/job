{
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=24.7"
  },
  "scripts": {
    "db:up": "docker compose up -d postgres",
    "db:migrate": "prisma migrate dev --config prisma7.config.ts",
    "db:generate": "prisma generate --config prisma7.config.ts",
    "db:seed": "prisma db seed --config prisma7.config.ts",
    "db:reset": "prisma migrate reset --force --config prisma7.config.ts && prisma db seed --config prisma7.config.ts",
    "db:studio": "prisma studio --config prisma7.config.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p apps/test-client",
    "api:dev": "tsx watch apps/api/src/server.ts",
    "api:start": "tsx apps/api/src/server.ts",
    "test": "tsx scripts/test.ts",
    "client:dev": "vite apps/test-client",
    "api:install-browser": "playwright-core install chromium-headless-shell",
    "jobs:cleanup": "tsx apps/api/src/jobs/run-cleanup.ts",
    "ai:check": "tsx apps/api/src/ai/check.ts",
    "collector": "tsx apps/job_collector/src/cli.ts",
    "collector:start": "tsx apps/job_collector/src/main.ts",
    "collector:up": "docker compose --profile collector up -d collector",
    "collector:logs": "docker compose logs -f --tail 100 collector"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "dotenv": "^18.0.7",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "prisma": "^7.10.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
