# Web server in front of everything (DEPLOYMENT.md): HTTPS certificates obtained and
# renewed automatically for $DOMAIN, the built frontend, and /api forwarded to the API.
{
	email {$ACME_EMAIL}
}

# The app's pages only load its own code and fonts and talk to its own API; the resume
# preview frame is the API's own page.
(app_csp) {
	header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self'; frame-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
}

# One address for the site: www goes to the bare domain.
www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}

{$DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
		-Server
	}

	handle /api/* {
		reverse_proxy api:3000
	}

	# Audience measurement (Umami, GROWTH.md): only its script and its collection endpoint,
	# on the site's own address (first party: the CSP stays 'self'). The dashboard is on
	# stats.{$DOMAIN}.
	handle /u/script.js {
		rewrite * /script.js
		reverse_proxy umami:3000
	}
	handle /u/api/send {
		rewrite * /api/send
		reverse_proxy umami:3000
	}

	# Pages for search engines (SEO.md): offer pages rendered by the API on the app's page,
	# landing pages by job and town, sitemaps, robots.txt.
	@seo path /offers/* /emplois /emplois/* /alternance /alternance/* /stage /stage/* /sitemap.xml /sitemaps/* /robots.txt /indexnow/*
	handle @seo {
		import app_csp
		reverse_proxy api:3000
	}

	handle {
		root * /srv
		import app_csp
		# Hashed file names never change: cached for a year. The page itself is always revalidated.
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		@page not path /assets/*
		header @page Cache-Control "no-cache"
		# Installable app (FRONTEND.md): the manifest's type isn't in Caddy's list.
		@manifest path /manifest.webmanifest
		header @manifest Content-Type "application/manifest+json"
		try_files {path} /index.html
		file_server
	}
}

# Umami's dashboard (GROWTH.md), behind its own login. Needs the DNS record of
# DEPLOYMENT.md §3.
stats.{$DOMAIN} {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
	reverse_proxy umami:3000
}
