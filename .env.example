# Copy to .env and fill in. .env is never committed.

# PostgreSQL (docker-compose.yml)
DATABASE_URL=postgresql://job:job_dev_password@localhost:5433/job

# AI (FEATURE G5). Provider: gemini (fake is for tests only).
AI_PROVIDER=gemini
AI_MODEL=gemini-3.8-flash
# From Google AI Studio. Free tier: Google may use the requests to improve its products,
# use the paid tier for real users' data.
GEMINI_API_KEY=

# France Travail (job collector, phase 2): application credentials from francetravail.io
FRANCE_TRAVAIL_CLIENT_ID=
FRANCE_TRAVAIL_CLIENT_SECRET=

# Geoapify place autocomplete (optional: without it only the locations table is searched)
GEOAPIFY_API_KEY=
# Countries searched, ISO 3166-1 alpha-2, comma-separated
# GEOAPIFY_COUNTRIES=fr

# Emails (A4, A6). Development: MailHog from docker-compose, web UI http://localhost:8026
SMTP_HOST=localhost
SMTP_PORT=1026
# SMTP_SECURE=true
# SMTP_USER=
# SMTP_PASSWORD=
MAIL_FROM="MonPoste <no-reply@monposte.local>"
# Frontend address used in email links (5173: test client; 5174: the web app, apps/web)
WEB_BASE_URL=http://localhost:5173

# Optional
# PORT=3000
# WEB_ORIGINS=http://localhost:5173,http://localhost:5174
# STORAGE_LOCAL_DIR=storage
# Tests (npm test): default is DATABASE_URL's database name + "_test", and storage-test
# Career-site crawler: set to false to ignore robots.txt Allow/Disallow rules (default: obeyed)
# CRAWLER_RESPECT_ROBOTS_TXT=true
# TEST_DATABASE_URL=postgresql://job:job_dev_password@localhost:5433/job_test
# TEST_STORAGE_LOCAL_DIR=storage-test
# CLEANUP_INTERVAL_HOURS=24
