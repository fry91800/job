# Copy to .env and fill in. .env is never committed.

# PostgreSQL (docker-compose.yml)
DATABASE_URL=postgresql://job:job_dev_password@localhost:5432/job

# AI (FEATURE G5). Provider: gemini (fake is for tests only).
AI_PROVIDER=gemini
AI_MODEL=gemini-3.8-flash
# From Google AI Studio. Free tier: Google may use the requests to improve its products,
# use the paid tier for real users' data.
GEMINI_API_KEY=

# Optional
# PORT=3000
# WEB_ORIGINS=http://localhost:5173
# STORAGE_LOCAL_DIR=storage
# CLEANUP_INTERVAL_HOURS=24
