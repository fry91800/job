# Production settings (DEPLOYMENT.md). Copy to .env.production on the server, fill in,
# keep it out of git (chmod 600). The API and the worker refuse to start when a required
# value is missing or still a development one.

# --- Domain and HTTPS (Caddy) ---
DOMAIN=monposte.com                     # www.monposte.com redirects here
ACME_EMAIL=admin@monposte.com            # Let's Encrypt account (expiry notices)

# --- Database (the postgres service) ---
POSTGRES_USER=job
POSTGRES_PASSWORD=change-me-long-random  # e.g. openssl rand -base64 32
POSTGRES_DB=job
DATABASE_URL=postgresql://job:change-me-long-random@postgres:5432/job

# --- API ---
NODE_ENV=production
TRUST_PROXY=1                           # one reverse proxy (Caddy) in front
WEB_BASE_URL=https://monposte.com   # links in emails
WEB_ORIGINS=https://monposte.com

# --- AI and places ---
GEMINI_API_KEY=
AI_DAILY_BUDGET_USD=2                   # AI calls pause for the day (UTC) beyond this estimate
# AI_MODEL_GENERATE=gemini-3.8-flash    # models per task (DEPLOYMENT.md §8); defaults in packages/backend/src/config.ts
# AI_MODEL_EXTRACT=gemini-3.5-flash-lite
# AI_MODEL_TRANSLATE=gemini-3.5-flash-lite
GEOAPIFY_API_KEY=                       # required: place search and offer locations

# --- Email provider (any SMTP: Brevo, Postmark, Mailjet, Amazon SES…) ---
SMTP_HOST=smtp.provider.example
SMTP_PORT=587
SMTP_SECURE=false                       # true for port 465
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="MonPoste <no-reply@monposte.com>"

# --- Feedback and audience measurement (GROWTH.md) ---
FEEDBACK_EMAIL=contact@monposte.com     # where the "Un avis ?" messages go
UMAMI_APP_SECRET=change-me-long-random  # openssl rand -hex 32
UMAMI_WEBSITE_ID=                       # from Umami (Settings → Websites), after its first start

# --- Job collector ---
CRAWLER_CONTACT_URL=https://monposte.com/bot.html   # the page explaining the crawler (served by the site)
CRAWLER_CONTACT_EMAIL=bot@monposte.com
# CRAWLER_RESPECT_ROBOTS_TXT=true

# --- Operations ---
ALERT_WEBHOOK_URL=                      # Slack / Discord / Mattermost incoming webhook
APP_NAME=monposte
BACKUP_HOUR=2                           # UTC
BACKUP_KEEP_DAYS=14
# HTTP_PORT=80
# HTTPS_PORT=443
