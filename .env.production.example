# Production settings (DEPLOYMENT.md). Copy to .env.production on the server, fill in,
# keep it out of git (chmod 600). The API and the worker refuse to start when a required
# value is missing or still a development one.

# --- Domain and HTTPS (Caddy) ---
DOMAIN=jobs.example.com
ACME_EMAIL=admin@example.com            # Let's Encrypt account (expiry notices)

# --- Database (the postgres service) ---
POSTGRES_USER=job
POSTGRES_PASSWORD=change-me-long-random  # e.g. openssl rand -base64 32
POSTGRES_DB=job
DATABASE_URL=postgresql://job:change-me-long-random@postgres:5432/job

# --- API ---
NODE_ENV=production
TRUST_PROXY=1                           # one reverse proxy (Caddy) in front
WEB_BASE_URL=https://jobs.example.com   # links in emails
WEB_ORIGINS=https://jobs.example.com

# --- AI and places ---
GEMINI_API_KEY=
GEOAPIFY_API_KEY=

# --- Email provider (any SMTP: Brevo, Postmark, Mailjet, Amazon SES…) ---
SMTP_HOST=smtp.provider.example
SMTP_PORT=587
SMTP_SECURE=false                       # true for port 465
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="Job <no-reply@jobs.example.com>"

# --- Job collector ---
CRAWLER_CONTACT_URL=https://jobs.example.com/bot.html   # the page explaining the crawler (served by the site)
CRAWLER_CONTACT_EMAIL=bot@jobs.example.com
# CRAWLER_RESPECT_ROBOTS_TXT=true

# --- Operations ---
ALERT_WEBHOOK_URL=                      # Slack / Discord / Mattermost incoming webhook
APP_NAME=job
BACKUP_HOUR=2                           # UTC
BACKUP_KEEP_DAYS=14
# HTTP_PORT=80
# HTTPS_PORT=443
